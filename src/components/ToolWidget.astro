---
import type { ToolPage } from '../data/tools';
const { tool } = Astro.props as { tool: ToolPage };
const isImage = tool.mode === 'image-redactor';
const isJwt = tool.mode === 'jwt-checker';
const isUrl = tool.mode === 'url-cleaner';
const isJson = tool.mode === 'json-redactor';
const isTextRedactor = tool.mode === 'text-redactor';
const isDeveloperRedactor = tool.mode === 'developer-redactor';
const supportsPatternControls = isTextRedactor || isDeveloperRedactor;
const patternOptions = isDeveloperRedactor
  ? ['JWT', 'Bearer token', 'API key assignment', 'AWS-like key', 'Database URL', 'IP address', 'Email', 'URL', 'File path', 'ID']
  : ['Email', 'Phone', 'JWT', 'Bearer token', 'API key assignment', 'IP address', 'URL', 'Amount', 'Date', 'ID', 'Possible name'];
const defaultJsonKeys = 'email,phone,name,address,token,secret,password,api_key,access_token,refresh_token,user_id,customer_id,account_id';
---
<section class="tool-panel" data-tool data-mode={tool.mode} data-tool-name={tool.name} data-sample={tool.exampleUnsafe}>
  <div class="panel-head">
    <div>
      <h2>{tool.name}</h2>
      <p>{tool.interfaceHint}</p>
    </div>
    <div class="tool-privacy-note">Local processing: your input is handled by JavaScript in this browser.</div>
  </div>

  {isImage ? (
    <div class="image-tool" data-image-tool>
      <div class="field">
        <label for="image-file">Choose an image</label>
        <input id="image-file" type="file" accept="image/png,image/jpeg,image/webp" />
        <p class="field-help">The editor scales visually to fit the page, but the downloaded PNG keeps the original image dimensions.</p>
      </div>
      <div class="image-workspace">
        <div class="canvas-wrap">
          <canvas id="redaction-canvas" width="900" height="520" aria-label="Interactive image redaction canvas. Drag over private areas to create redaction boxes."></canvas>
        </div>
        <div class="content-card">
          <h3>Review the full image</h3>
          <div class="checklist">
            <label><input type="checkbox" /> Names, emails, and phone numbers</label>
            <label><input type="checkbox" /> Account, invoice, order, and case IDs</label>
            <label><input type="checkbox" /> Browser tabs, URLs, menus, and notifications</label>
            <label><input type="checkbox" /> Payment, location, profile, and access details</label>
          </div>
          <div class="tool-controls">
            <select id="redaction-style" aria-label="Redaction style">
              <option value="solid">Solid cover</option>
              <option value="blur">Blur area</option>
            </select>
            <button class="btn" type="button" data-undo-box>Undo last box</button>
            <button class="btn" type="button" data-clear-boxes>Clear boxes</button>
            <button class="btn btn-primary" type="button" data-download-image>{tool.primaryButton}</button>
          </div>
          <p class="muted">Drag over the image to create redaction boxes. Use a solid cover when text must be unreadable.</p>
          <div class="alert" data-image-status aria-live="polite">Choose an image to begin.</div>
        </div>
      </div>
    </div>
  ) : isJwt ? (
    <div class="tool-grid">
      <div class="field">
        <label for="tool-input">JWT token</label>
        <textarea id="tool-input" placeholder={tool.emptyState} autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <div class="tool-controls">
          <button class="btn" type="button" data-load-jwt-sample>Load safe sample</button>
          <button class="btn btn-primary" type="button" data-run-tool>{tool.primaryButton}</button>
          <button class="btn" type="button" data-clear-tool>Clear locally</button>
        </div>
      </div>
      <div>
        <label>Decoded header and payload</label>
        <div class="tool-output" data-output aria-live="polite">Decoded JWT details will appear here.</div>
        <div class="stats" data-stats></div>
        <div class="alert">This tool does not verify the signature, expiry, revocation status, or trustworthiness of the token.</div>
      </div>
    </div>
  ) : isUrl ? (
    <div class="tool-grid">
      <div class="field">
        <label for="tool-input">URLs or text containing URLs</label>
        <textarea id="tool-input" placeholder={tool.emptyState} autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <div class="field">
          <label for="url-clean-mode">Cleaning mode</label>
          <select id="url-clean-mode" data-url-clean-mode>
            <option value="safe">Safe: remove well-known tracking parameters</option>
            <option value="review">Review: also remove common identity and referral fields</option>
          </select>
          <label><input type="checkbox" data-remove-fragment /> Remove URL fragments (#...)</label>
          <p class="field-help">Safe mode is the default because parameters such as ref, source, user, session, or fragments can be functional on some sites.</p>
        </div>
        <div class="tool-controls">
          <button class="btn" type="button" data-load-sample>Load sample</button>
          <button class="btn btn-primary" type="button" data-run-tool>{tool.primaryButton}</button>
          <button class="btn" type="button" data-copy-output>Copy cleaned links</button>
          <button class="btn" type="button" data-clear-tool>Clear locally</button>
        </div>
      </div>
      <div>
        <label>Cleaned output</label>
        <div class="tool-output" data-output aria-live="polite">Cleaned URLs will appear here.</div>
        <div class="stats" data-stats></div>
        <div class="alert" data-url-report aria-live="polite">Run the cleaner to see which parameter names were removed and which were preserved.</div>
      </div>
    </div>
  ) : (
    <div class="tool-grid">
      <div class="field">
        <label for="tool-input">Input</label>
        <textarea id="tool-input" placeholder={tool.emptyState} autocomplete="off" autocapitalize="off" spellcheck="false"></textarea>
        <div class="tool-controls">
          <input type="file" data-file-input accept=".txt,.csv,.json,.log,.env,text/plain,application/json,text/csv" aria-label="Choose a local text file" />
          <button class="btn" type="button" data-load-sample>Load sample</button>
        </div>

        {supportsPatternControls && (
          <div>
            <label>Detection categories</label>
            <div class="checklist">
              {patternOptions.map((pattern) => (
                <label><input type="checkbox" data-pattern-key value={pattern} checked /> {pattern}</label>
              ))}
            </div>
          </div>
        )}

        {isJson && (
          <div class="field">
            <label for="json-mask-keys">Sensitive JSON keys</label>
            <input id="json-mask-keys" type="text" data-mask-keys value={defaultJsonKeys} autocomplete="off" />
            <p class="field-help">Comma-separated key names. Matching uses whole key segments recursively, so user_name matches name while filename does not. Remaining string values are also scanned for common sensitive patterns.</p>
          </div>
        )}

        <label><input type="checkbox" data-stable-placeholders checked /> Reuse numbered placeholders for repeated values</label>

        <div class="tool-controls">
          <button class="btn btn-primary" type="button" data-run-tool>{tool.primaryButton}</button>
          <button class="btn" type="button" data-copy-output>Copy cleaned text</button>
          <button class="btn" type="button" data-download-output>Download cleaned file</button>
          <button class="btn" type="button" data-clear-tool>Clear locally</button>
        </div>
      </div>
      <div>
        <label>Cleaned output</label>
        <div class="tool-output" data-output aria-live="polite">Results will appear here after scanning.</div>
        <div class="stats" data-stats></div>
        {isJson && <div class="alert" data-json-status aria-live="polite">Valid JSON is parsed recursively. Invalid JSON falls back to text-only redaction and will be clearly flagged.</div>}
        <div class="alert">Automated detection is a first pass. Review context-specific identifiers before sharing the result.</div>
      </div>
    </div>
  )}
</section>
<script src="/scripts/toolbox.js" defer></script>
